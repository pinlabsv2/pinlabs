{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [{ "path": "/api/runEmailMaintenance", "schedule": "*/5 * * * *" }],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
