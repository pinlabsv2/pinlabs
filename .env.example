# Production database (local development uses PGlite when unset)
DATABASE_URL=

# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional comma-separated admin emails
ADMIN_EMAILS=

# Required for 17TRACK registration and refreshes
TRACK17_API_KEY=

# Required for /api/track17Webhook?secret=<value>
TRACK17_WEBHOOK_SECRET=

# Optional local PGlite storage directory
PGLITE_DIR=./.data/pglite

# Public origin used for provider callback URLs
PUBLIC_APP_URL=http://localhost:3000

# fake locally; use sandbox or live only with dedicated credentials
PAYMENT_PROVIDER_MODE=fake
NOWPAYMENTS_API_BASE_URL=https://api-sandbox.nowpayments.io
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAYOUT_EMAIL=
NOWPAYMENTS_PAYOUT_PASSWORD=

# fake locally; set to live after verifying a sending domain
EMAIL_PROVIDER_MODE=fake
RESEND_API_BASE_URL=https://api.resend.com
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=

# fake locally; use live with TRACK17_API_KEY
TRACKING_PROVIDER_MODE=fake
TRACK17_API_BASE_URL=https://api.17track.net/track/v2.2

# fake locally; use live with a dedicated Vercel Blob store
REVIEW_IMAGE_PROVIDER_MODE=fake
BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_API_URL=https://blob.vercel-storage.com

# Bearer secret for bounded maintenance jobs
CRON_SECRET=
